###############################################################################
# .gitignore - identificadores_de_contribuyentes
# ASP.NET Web Forms / .NET Framework 4.7.2 / Visual Studio
###############################################################################

###############################################################################
# 1. SECRETOS Y CONFIGURACION SENSIBLE  (lo mas importante)
###############################################################################
# Web.config contiene credenciales de los web services (Entity, REQUESTOR,
# User, UserName). Lo correcto es NO subirlo y publicar solo una plantilla
# Web.config.example / Web.config.template con los valores en blanco.
Web.config
*.config.local
Web.*.config.local

# Archivos de configuracion externalizada con secretos.
# (usar <appSettings configSource="AppSettings.secrets.config" /> en Web.config)
AppSettings.secrets.config
ConnectionStrings.config
ConnectionStrings.secrets.config
*.secrets.config
secrets.json
appsettings.*.local.json

# Variables de entorno
.env
.env.*
!.env.example

# Certificados, llaves y credenciales
*.pfx
*.p12
*.key
*.pem
*.cer
*.crt
*.snk
*.jks
*.keystore
credentials.*
*credentials.json

# Perfiles de publicacion: pueden incluir usuario/password del servidor destino
*.pubxml.user
*.publishproj
PublishProfiles/*.user
PublishScripts/
publish/

# Transformaciones con datos de servidores reales
Web.Production.config
Web.Prod.config
Web.QA.config
Web.Staging.config

###############################################################################
# 2. Excepciones: plantillas SI se suben
###############################################################################
!Web.config.example
!Web.config.template
!AppSettings.secrets.config.example

